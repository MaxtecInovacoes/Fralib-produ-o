[Unit]
Description=FraLib Phone Health Score (hourly)
Documentation=https://github.com/...
After=network-online.target
Wants=network-online.target

[Timer]
# Roda a cada hora, 7 minutos depois do minuto (evita :00/:30 spike)
# 'hourly' = :00:00; o service eh rapido (~5s) entao nao conflita
OnCalendar=hourly
# Catchup se a maquina ficou off
Persistent=true
Unit=fralib-phone-health.service

[Install]
WantedBy=timers.target