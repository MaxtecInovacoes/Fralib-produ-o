[Unit]
Description=FraLib API (FastAPI + uvicorn)
Documentation=https://github.com/...
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/fralib
Environment="PATH=/root/fralib/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/etc/fralib/fralib.env
ExecStart=/root/fralib/venv/bin/python3 /root/fralib/server.py --host 0.0.0.0 --port 8000
ExecStop=/bin/kill -TERM $MAINPID
ExecReload=/bin/kill -HUP $MAINPID

# Recursos
MemoryMax=1G
MemoryHigh=768M
CPUQuota=150%
TasksMax=100
LimitNOFILE=65535

# Restart policy
Restart=on-failure
RestartSec=5s

# Segurança
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

# Logs via journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fralib-api

[Install]
WantedBy=multi-user.target