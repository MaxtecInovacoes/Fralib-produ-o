[Unit]
Description=FraLib Pipeline Worker
Documentation=https://github.com/...
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/fralib
Environment="PATH=/root/fralib/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/etc/fralib/fralib.env
ExecStart=/root/fralib/venv/bin/python3 /root/fralib/worker.py

# Recursos (worker pesado — gera sites)
MemoryMax=2G
MemoryHigh=1536M
CPUQuota=200%
TasksMax=200
LimitNOFILE=65535

# Restart policy
Restart=on-failure
RestartSec=10s

# Segurança
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

# Logs via journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fralib-worker

[Install]
WantedBy=multi-user.target