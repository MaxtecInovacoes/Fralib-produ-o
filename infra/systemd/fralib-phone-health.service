[Unit]
Description=FraLib Phone Health Score computation
After=network-online.target fralib-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/fralib
Environment="PATH=/root/fralib/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/etc/fralib/fralib.env

ExecStart=/bin/bash -c 'curl -sS -X POST http://localhost:8080/api/cron/compute-phone-health-score \
  -H "X-Cron-Secret: ${FRALIB_CRON_SECRET}" \
  -H "Content-Type: application/json" \
  --max-time 60 -w "\nHTTP %{http_code} in %{time_total}s\n"'

# Limites (oneshot, entao baixo)
MemoryMax=128M
CPUQuota=50%
TasksMax=20
LimitNOFILE=1024

# Restart so em falha (diagnostico)
Restart=on-failure
RestartSec=30s
StartLimitBurst=3
StartLimitIntervalSec=300

# Logs via journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fralib-phone-health

# Seguranca minima
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target