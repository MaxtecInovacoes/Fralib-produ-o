[Unit]
Description=FraLib WhatsApp Listener
Documentation=https://github.com/...
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/fralib
Environment="PATH=/root/fralib/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/etc/fralib/fralib.env
ExecStart=/root/fralib/venv/bin/python3 /root/fralib/backend/whatsapp_listener.py --env production

# Recursos
MemoryMax=512M
MemoryHigh=384M
CPUQuota=100%
TasksMax=50
LimitNOFILE=65535

# Restart policy
Restart=on-failure
RestartSec=5s

# Segurança
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

# Logs via journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fralib-wpp-listener

[Install]
WantedBy=multi-user.target