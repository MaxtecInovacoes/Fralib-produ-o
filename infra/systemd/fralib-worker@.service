[Unit]
Description=FraLib Pipeline Worker Instance %i
Documentation=https://github.com/...
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/fralib
Environment="PATH=/root/fralib/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/etc/fralib/fralib.env
Environment="WORKER_JOB_TYPES=pipeline_lead,pipeline_multiplos"
Environment="LEAD_SUPPLY_SYNC_SECS=0"
Environment="MAX_PIPELINES_GLOBAL=2"
Environment="FRALIB_UNLIMITED_PIPELINE_TENANTS=2"
ExecStart=/root/fralib/venv/bin/python3 /root/fralib/worker.py

# Extra pipeline instances only render/build. Keep concurrency conservative.
MemoryMax=2G
MemoryHigh=1536M
CPUQuota=200%
TasksMax=200
LimitNOFILE=65535

Restart=on-failure
RestartSec=10s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fralib-worker-%i

[Install]
WantedBy=multi-user.target
