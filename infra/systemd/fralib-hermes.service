[Unit]
Description=FraLib Hermes Watchdog
Documentation=https://github.com/...
After=network-online.target fralib-api.service fralib-worker.service fralib-wpp-listener.service fralib-franz.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/fralib/scripts
Environment="PATH=/root/fralib/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/etc/fralib/fralib.env
ExecStart=/root/fralib/venv/bin/python3 /root/fralib/scripts/hermes_daemon.py

# Recursos (vigilante — leve)
MemoryMax=256M
MemoryHigh=192M
CPUQuota=50%
TasksMax=20
LimitNOFILE=4096

# Restart policy
Restart=always
RestartSec=30s
StartLimitIntervalSec=300s
StartLimitBurst=3

# Segurança
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

# Logs via journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fralib-hermes

[Install]
WantedBy=multi-user.target