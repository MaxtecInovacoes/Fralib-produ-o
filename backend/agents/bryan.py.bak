def clean_control_characters(text: str) -> str:
    """Remove caracteres de controle inválidos do JSON"""
    import re
    # Remove caracteres de controle exceto \n, \r, \t
    return re.sub(r'[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]', '', text)


def sanitize_text(text: str) -> str:
    """Sanitiza texto para uso seguro em prompts e JSON"""
    if not text:
        return ""
    import re
    # Remove caracteres de controle
    text = clean_control_characters(str(text))
    # Normaliza espaços múltiplos
    text = re.sub(r'\s+', ' ', text)
    # Remove espaços no início e fim
    return text.strip()

# ===== MODELOS PYDANTIC =====

class BryanInput(BaseModel):
    """Entrada do Bryan - Lead qualificado + Site pronto"""
    nome: str
    cidade: str
    segmento: str
    telefone: str
    whatsapp: Optional[str] = None
    rating: Optional[float] = 0
    site_url: Optional[str] = None  # URL do site gerado
    score_caio: Optional[int] = 0
    concorrentes: Optional[Dict] = None  # Dados de concorrentes do Jina (top3, padroes, recomendacoes)
    tier: Optional[str] = "STANDARD"

class MensagemWhatsApp(BaseModel):
    """Mensagem para enviar no WhatsApp"""
    texto: str = Field(..., min_length=10, max_length=500)
    tipo: str  # intro, follow_up_24h, follow_up_72h, resposta
    emojis_count: int = Field(default=0, ge=0, le=3)

class BryanOutput(BaseModel):
    """Saída do Bryan - Mensagem de contato"""
    mensagem: MensagemWhatsApp
    estrategia: str  # SOFT_SELL, HARD_SELL, CONSULTIVO
    proximo_passo: str
    enviado: bool = False

# ===== STATE MACHINE SDR =====

ESTADOS_SDR = [
    "intro",           # Apresentação inicial
    "proof",           # Prova social (reviews, cases)
    "link",            # Envio do link do site
    "value",           # Proposta de valor
    "price",           # Preço e condições
    "close",           # Fechamento
    "won",             # Ganho
    "lost"             # Perdido
]

# ===== ESTRATÉGIAS POR TIER =====

def detectar_estrategia(tier: str, score: int) -> str:
    """Detecta estratégia de abordagem baseada no tier"""
    if tier == "PREMIUM" or score >= 80:
        return "CONSULTIVO"  # Abordagem consultiva, foco em valor
    elif tier == "STANDARD" or score >= 60:
        return "SOFT_SELL"   # Abordagem suave, educativa
    else:
        return "HARD_SELL"   # Abordagem direta, urgência

# ===== AGENTE BRYAN =====

BRYAN_INSTRUCTIONS = """Você é Bryan, SDR (Sales Development Representative) da FraLib.

## TAREFA
Crie mensagem de WhatsApp para iniciar contato com lead qualificado.

## CONTEXTO
A FraLib cria sites profissionais para pequenos negócios brasileiros.
O site do cliente JÁ ESTÁ PRONTO e hospedado.
Você está fazendo o primeiro contato para apresentar o site.

## REGRAS OBRIGATÓRIAS
1. Mensagem CURTA: máximo 4 linhas (500 caracteres)
2. Tom HUMANO: escreva como pessoa, não como bot
3. Emojis COM MODERAÇÃO: máximo 2 por mensagem
4. SEMPRE termine com pergunta para engajar
5. NUNCA exponha raciocínio interno ou ferramentas
6. Use nome do negócio e cidade para personalizar
7. Foco no BENEFÍCIO, não nas features técnicas

## ESTRATÉGIAS

### CONSULTIVO (leads premium, score 80+)
- Tom: profissional, consultivo
- Foco: transformação digital, resultados
- Exemplo: "Olá [Nome]! Notei que [Negócio] tem ótimas avaliações em [Cidade]. Criamos um site profissional que pode aumentar ainda mais sua visibilidade online. Posso te mostrar?"

### SOFT_SELL (leads standard, score 60-79)
- Tom: amigável, educativo
- Foco: facilidade, modernização
- Exemplo: "Oi [Nome]! Vi que [Negócio] está bem avaliado em [Cidade]. Que tal ter um site moderno para atrair mais clientes? Já deixamos tudo pronto pra você! 😊"

### HARD_SELL (leads baixo score, <60)
- Tom: direto, urgência
- Foco: oportunidade, ação rápida
- Exemplo: "Olá! Criamos um site profissional para [Negócio] em [Cidade]. Está pronto e pode começar a usar hoje mesmo. Quer ver? 🚀"

## FORMATO DE SAÍDA
Retorne JSON estruturado:
```json
{{
  "texto": "mensagem aqui",
  "tipo": "intro",
  "emojis_count": 1
}}
```

**IMPORTANTE:**
- Seja genuíno e humano
- Evite jargão técnico
- Foque no benefício para o cliente
- Crie curiosidade sem ser invasivo
"""

# ===== HISTÓRICO DE INTERAÇÕES =====

def _carregar_historico_interacoes(telefone: str, limite: int = 5) -> str:
    """
    Carrega as últimas N mensagens da tabela interacoes para o lead.
    Retorna string formatada 'Bryan: msg\\nLead: resposta' ou '' se falhar.
    """
    try:
        from sqlalchemy import create_engine, text as sa_text
        db_url = os.getenv("DATABASE_URL", "")
        if not db_url:
            return ""
        engine = create_engine(db_url)
        with engine.connect() as conn:
            rows = conn.execute(
                sa_text(
                    """
                    SELECT i.mensagem, i.direcao
                    FROM interacoes i
                    JOIN leads l ON l.id = i.lead_id
                    WHERE l.telefone = :tel
                    ORDER BY i.id DESC
                    LIMIT :lim
                    """
                ),
                {"tel": telefone, "lim": limite}
            ).fetchall()
        if not rows:
            return ""
        # Inverte para ordem cronológica
        rows = list(reversed(rows))
        linhas = []
        for row in rows:
            autor = "Bryan" if row.direcao == "saida" else "Lead"
            linhas.append(f"{autor}: {row.mensagem}")
        return "\n".join(linhas)
    except Exception as e:
        print(f"[Bryan] Aviso: não foi possível carregar histórico: {e}")
        return ""


# Função criar_agente_bryan() removida - não é mais necessária com HTTP direto

def clean_json_response(text: str) -> str:
    """Remove markdown code blocks do JSON"""
    text = re.sub(r'```json\s*', '', text)
    text = re.sub(r'```\s*$', '', text)
    return text.strip()

def safe_json_loads(text: str) -> dict:
    """Parse JSON com sanitizacao agressiva de caracteres de controle"""
    # 1. Remover chars de controle do texto completo
    text = clean_control_characters(text)
    # 2. Encode/decode para limpar qualquer char invalido residual
    text = text.encode('utf-8', errors='ignore').decode('utf-8', errors='ignore')
    # 3. Substituir chars de controle dentro de strings JSON por espaco
    text = re.sub(r'[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]', ' ', text)
    # 4. Normalizar quebras de linha dentro de strings
    text = re.sub(r'(?<!\\)\n', ' ', text)
    return json.loads(text)

@require_rag("Bryan")
def iniciar_contato(lead: BryanInput) -> BryanOutput:
    """
    Inicia contato com lead qualificado

    Args:
        lead: Dados do lead qualificado

    Returns:
        Mensagem de contato estruturada
    """
    # Detectar estratégia
    estrategia = detectar_estrategia(lead.tier or "STANDARD", lead.score_caio or 0)

    # Verificar se já contatou antes
    memoria = carregar_memoria(f"bryan_lead_{lead.telefone}")
    if memoria:
        print(f"⚠️ [Bryan] Lead {lead.nome} já foi contatado antes")
        ultimo_estado = memoria.get("estado", "intro")
        tentativas = memoria.get("tentativas", 0)
    else:
        ultimo_estado = "intro"
        tentativas = 0

    # Sanitizar campos do lead antes de usar no prompt
    nome_safe = sanitize_text(lead.nome)
    cidade_safe = sanitize_text(lead.cidade)
    segmento_safe = sanitize_text(lead.segmento)
    tier_safe = sanitize_text(lead.tier)

    # Carregar histórico de interações anteriores
    historico = _carregar_historico_interacoes(lead.telefone)
    historico_bloco = f"\n**HISTÓRICO DE MENSAGENS:**\n{historico}\n" if historico else ""

    # Montar prompt
    prompt = f"""Crie mensagem de WhatsApp para iniciar contato:

**NEGÓCIO:** {nome_safe}
**CIDADE:** {cidade_safe}
**SEGMENTO:** {segmento_safe}
**AVALIAÇÃO:** {lead.rating or '?'}/5
**TIER:** {tier_safe}
**SCORE:** {lead.score_caio or 0}/100

**ESTRATÉGIA:** {estrategia}
**ESTADO ATUAL:** {ultimo_estado}
**TENTATIVAS:** {tentativas}
{historico_bloco}
{f"**SITE PRONTO:** {lead.site_url}" if lead.site_url else "**SITE:** Em preparação final"}

Crie mensagem de primeiro contato seguindo a estratégia {estrategia}.
Retorne JSON com texto, tipo e emojis_count.
"""

    try:
        # ✅ Integrar RAG
        rag_context = buscar_contexto_rag("contato sdr whatsapp", "bryan")
        full_prompt = format_rag_prompt(prompt, rag_context)
        mark_rag_used("bryan")
        temperature = get_agent_temperature("bryan")
        print(f"[Bryan] Usando temperature={temperature} (criativo/persuasivo)")

        # Chamar Claude via HTTP com RAG + temperatura
        response_text = call_claude(
            system=BRYAN_INSTRUCTIONS,
            user=full_prompt,
            model="sonnet",
            max_tokens=600,
            temperature=temperature,
            agent_name="Bryan"
        )

        print(f"[Bryan] Resposta recebida: {len(response_text)} chars")

        # Limpar markdown do JSON
        clean_text = clean_json_response(response_text)

        # Parse JSON
        response_json = safe_json_loads(clean_text)

        # Validar com Pydantic
        mensagem = MensagemWhatsApp(**response_json)

        # Definir próximo passo
        proximo_passo = "Aguardar resposta do lead (24h)"
        if tentativas >= 2:
            proximo_passo = "Lead frio - aguardar 72h antes de novo contato"

        # Salvar memória com estado real retornado pelo LLM (campo 'proximo_estado') ou avançar na state machine
        proximo_estado = response_json.get("proximo_estado", None)
        if not proximo_estado or proximo_estado not in ESTADOS_SDR:
            # Avança automaticamente na state machine
            idx_atual = ESTADOS_SDR.index(ultimo_estado) if ultimo_estado in ESTADOS_SDR else 0
            idx_prox = min(idx_atual + 1, len(ESTADOS_SDR) - 1)
            proximo_estado = ESTADOS_SDR[idx_prox]

        salvar_memoria(f"bryan_lead_{lead.telefone}", {
            "lead": lead.model_dump(),
            "mensagem": mensagem.model_dump(),
            "estrategia": estrategia,
            "estado": proximo_estado,
            "tentativas": tentativas + 1,
            "proximo_passo": proximo_passo
        })

        print(f"✅ [Bryan] Mensagem criada para {lead.nome} ({estrategia})")
        print(f"   Texto: {mensagem.texto[:80]}...")

        return BryanOutput(
            mensagem=mensagem,
            estrategia=estrategia,
            proximo_passo=proximo_passo,
            enviado=False
        )

    except Exception as e:
        print(f"[Bryan] ❌ Erro ao criar mensagem: {e}")
        # Fallback
        return BryanOutput(
            mensagem=MensagemWhatsApp(
                texto=f"Olá! Vi que você tem um negócio em {lead.cidade}. Gostaria de conversar sobre como podemos ajudar?",
                tipo="intro",
                emojis_count=0
            ),
            estrategia=estrategia,
            proximo_passo="Aguardar resposta do lead (24h)",
            enviado=False
        )

def _consultar_aprendizado_segmento(segmento: str) -> str:
    """
    Consulta sdr_learning para o segmento e retorna contexto de aprendizado.
    Busca 3 convertidos e 3 perdidos mais recentes.
    """
    if not segmento:
        return ""
    try:
        from sqlalchemy import create_engine, text as sa_text
        db_url = os.getenv("DATABASE_URL", "")
        if not db_url:
            return ""
        engine = create_engine(db_url)
        with engine.connect() as conn:
            convertidos = conn.execute(sa_text("""
                SELECT mensagem_usada, observacao
                FROM sdr_learning
                WHERE resultado = 'convertido'
                  AND (segmento ILIKE :seg OR nicho ILIKE :seg)
                ORDER BY id DESC
                LIMIT 3
            """), {"seg": f"%{segmento}%"}).fetchall()

            perdidos = conn.execute(sa_text("""
                SELECT mensagem_usada, observacao
                FROM sdr_learning
                WHERE resultado = 'perdido'
                  AND (segmento ILIKE :seg OR nicho ILIKE :seg)
                ORDER BY id DESC
                LIMIT 3
            """), {"seg": f"%{segmento}%"}).fetchall()

        linhas = []
        if convertidos:
            linhas.append("Abordagens que funcionaram neste segmento:")
            for r in convertidos:
                msg = r[0] or ""
                obs = r[1] or ""
                trecho = (msg[:120] + "...") if len(msg) > 120 else msg
                if obs:
                    linhas.append(f"  - {trecho} [obs: {obs[:80]}]")
                else:
                    linhas.append(f"  - {trecho}")

        if perdidos:
            linhas.append("Abordagens que NAO funcionaram neste segmento:")
            for r in perdidos:
                msg = r[0] or ""
                obs = r[1] or ""
                trecho = (msg[:120] + "...") if len(msg) > 120 else msg
                if obs:
                    linhas.append(f"  - {trecho} [obs: {obs[:80]}]")
                else:
                    linhas.append(f"  - {trecho}")

        return "\n".join(linhas) if linhas else ""
    except Exception as e:
        print(f"[Bryan] Aviso: não foi possível consultar sdr_learning: {e}")
        return ""


def responder_lead(
    telefone: str,
    mensagem_recebida: str,
    nome_negocio: str = ""
) -> BryanOutput:
    """
    Responde mensagem do lead

    Args:
        telefone: Telefone do lead
        mensagem_recebida: Mensagem que o lead enviou
        nome_negocio: Nome do negócio

    Returns:
        Resposta estruturada
    """
    # Carregar contexto da conversa
    memoria = carregar_memoria(f"bryan_lead_{telefone}")
    if not memoria:
        print(f"⚠️ [Bryan] Sem contexto para lead {telefone}")
        contexto_anterior = "Primeira interação"
        segmento_lead = ""
    else:
        contexto_anterior = f"Estado: {memoria.get('estado', 'intro')}, Tentativas: {memoria.get('tentativas', 0)}"
        segmento_lead = memoria.get("lead", {}).get("segmento", "")

    # Consultar aprendizado do segmento no sdr_learning
    aprendizado = _consultar_aprendizado_segmento(segmento_lead)
    aprendizado_bloco = f"\n**APRENDIZADO DO SEGMENTO ({segmento_lead}):**\n{aprendizado}\n" if aprendizado else ""
    if aprendizado:
        print(f"[Bryan] Aprendizado carregado para segmento '{segmento_lead}': {len(aprendizado)} chars")

    # Montar prompt
    prompt = f"""Responda mensagem do lead no WhatsApp:

**LEAD:** {nome_negocio or "Cliente"}
**TELEFONE:** {telefone}
**CONTEXTO ANTERIOR:** {contexto_anterior}
{aprendizado_bloco}
**MENSAGEM RECEBIDA:**
"{mensagem_recebida}"

Crie resposta humana, curta (máximo 4 linhas) e direta.
Se não sabe algo, seja honesto.
Sempre termine com pergunta para engajar.

Retorne JSON com texto, tipo="resposta" e emojis_count.
"""

    try:
        # ✅ Integrar RAG
        rag_context = buscar_contexto_rag("contato sdr whatsapp", "bryan")
        full_prompt = format_rag_prompt(prompt, rag_context)
        mark_rag_used("bryan")
        temperature = get_agent_temperature("bryan")
        print(f"[Bryan] Usando temperature={temperature} (criativo/persuasivo)")

        # Chamar Claude via HTTP com RAG + temperatura
        response_text = call_claude(
            system=BRYAN_INSTRUCTIONS,
            user=full_prompt,
            model="sonnet",
            max_tokens=600,
            temperature=temperature,
            agent_name="Bryan"
        )

        print(f"[Bryan] Resposta recebida: {len(response_text)} chars")

        # Limpar markdown do JSON
        clean_text = clean_json_response(response_text)

        # Parse JSON
        response_json = safe_json_loads(clean_text)

        # Validar com Pydantic
        mensagem = MensagemWhatsApp(**response_json)

        # Atualizar memória
        if memoria:
            memoria["ultima_resposta"] = mensagem.model_dump()
            memoria["mensagens_trocadas"] = memoria.get("mensagens_trocadas", 0) + 1
            salvar_memoria(f"bryan_lead_{telefone}", memoria)

        print(f"✅ [Bryan] Resposta criada para {telefone}")

        return BryanOutput(
            mensagem=mensagem,
            estrategia=memoria.get("estrategia", "SOFT_SELL") if memoria else "SOFT_SELL",
            proximo_passo="Aguardar resposta do lead",
            enviado=False
        )

    except Exception as e:
        print(f"[Bryan] ❌ Erro ao criar resposta: {e}")
        # Fallback
        return BryanOutput(
            mensagem=MensagemWhatsApp(
                texto="Obrigado pela mensagem! Vou verificar e retorno em breve.",
                tipo="resposta",
                emojis_count=0
            ),
            estrategia="SOFT_SELL",
            proximo_passo="Aguardar resposta do lead",
            enviado=False
        )

