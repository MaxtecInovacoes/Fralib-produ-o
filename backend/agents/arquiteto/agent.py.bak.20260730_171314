def _extract_json(text: str) -> dict:
    text = text.strip()
    # Remove blocos <tool_code>...</tool_code> que o proxy "agente" injeta.
    cleaned = re.sub(r"<tool_code>.*?</tool_code>", "", text, flags=re.DOTALL).strip()
    if not cleaned:
        raise ValueError(f"Arquiteto: Claude devolveu texto vazio apos strip (input len={len(text)})")
    # Tenta parse direto. Se falhar, sai com a excecao original (fail-closed).
    try:
        return json.loads(cleaned)
    except json.JSONDecodeError:
        pass
    # Procura o PRIMEIRO bloco JSON balanceado (nao greedy ate o fim).
    decoder = json.JSONDecoder()
    for match in re.finditer(r"\{", cleaned):
        try:
            obj, _ = decoder.raw_decode(cleaned[match.start():])
            if isinstance(obj, dict) and obj:
                return obj
        except json.JSONDecodeError:
            continue
    # Nenhum JSON valido encontrado. Fail-closed: quem chama trata com raise.
    raise ValueError(
        f"Arquiteto: resposta do Claude nao contem JSON valido "
        f"(cleaned_preview={cleaned[:200]!r})"
    )


