def gerar_prd(lead: dict, usar_llm: bool = True, market_intelligence: dict | None = None) -> DesignerPRD:
    """Gera DesignerPRD via LLM. Falhas sobem para o Manager.

    Args:
        lead: dados do lead (nome, cidade, telefone, segmento, rating...)
        usar_llm: precisa ser True (canonico fail-closed)
        market_intelligence: dados de pesquisa de mercado (estrutura, tom, schema, concorrentes)
                             injetado no prompt como contexto adicional

    Fluxo:
      1. Deriva design_tokens via theme_mapper (deterministico, sem LLM).
      2. Pede pro LLM gerar conteudo (copy, hero, sections) usando os tokens
         como briefing injetado no system prompt + inteligencia de mercado.
      3. Monta DesignerPRD com design_tokens + layout_dna anexados.
    """
    if not usar_llm:
        raise ValueError("usar_llm=False nao eh suportado no Arquiteto canonico.")

    from backend.agents.llm.direct import call_claude
    from backend.services.theme_mapper import (
        derive_design_tokens,
        tokens_to_dict,
        archetype_briefing,
    )

    # Fase 3.3 — Design Feedback: consulta lessons do mesmo segmento
    try:
        from backend.services.design_feedback_engine import best_lesson_for
        from backend.core.database import SessionLocal

        _dl_db = SessionLocal()
        try:
            _lessons = best_lesson_for(_dl_db, lead.get("segmento", ""), min_score=6.0, limit=2)
        finally:
            _dl_db.close()
    except Exception:
        _lessons = []

    # 1. Tokens deterministicos — sao AUTORITATIVOS, o LLM nao escolhe paleta/tipografia.
    tokens = derive_design_tokens(
        segmento=lead.get("segmento", ""),
        cidade=lead.get("cidade", ""),
        nome=lead.get("nome", ""),
        rating=lead.get("rating"),
        lead_data=lead,
    )
    tokens_dict = tokens_to_dict(tokens)
    briefing = archetype_briefing(tokens.archetype)

    # Fase 2 — anti-clichê helpers injetados no system prompt.
    from backend.services.theme_mapper import (
        google_fonts_url as _gf_url,
        tailwind_config_inline as _tw_inline,
        forbidden_radius_for as _forbidden_radius,
        lazy_copy_words as _lazy_words,
    )
    fonts_url = _gf_url(tokens)
    forbidden_radius = _forbidden_radius(tokens.archetype)
    lazy_words = _lazy_words()

    system_with_briefing = (
        SYSTEM_PROMPT
        + "\n\n# DESIGN BRIEFING INJETADO (AUTORITATIVO — NAO ESCOLHA OUTROS VALORES)\n"
        + briefing
        + "\n\n# DESIGN TOKENS (use exatamente estes)\n"
        + f"archetype: {tokens.archetype}\n"
        + f"palette: {tokens_dict['palette']}\n"
        + f"typography: {tokens_dict['typography']}\n"
        + f"radius: {tokens_dict['radius']}\n"
        + f"layout_family: {tokens.layout_family}\n"
        + f"content_flow: {tokens.content_flow}\n"
        + f"hero_style: {tokens.hero_style}\n"
        + f"pattern_svg: {tokens.pattern_svg}\n"
        + f"icons: {tokens.icons}\n"
        + "\n# REGRAS INVIOLAVEIS (sobre DESIGN)\n"
        + "- As cores da paleta sao DEFINITIVAS (primary/accent/ink/paper/surface). "
        + "NAO use blue-500, slate-9xx, red-500 ou outros defaults Tailwind.\n"
        + "- A tipografia eh DEFINITIVA (display/body/mono). "
        + "Use Google Fonts link rel para cada uma.\n"
        + "- O border-radius respeita radius.default acima. "
        + "NAO use rounded-md/lg default sem justificativa.\n"
        + "- O layout_family define a topologia. NAO force 6 secoes fixas; "
        + "escolha 5-8 secoes que contem a historia do lead no flow "
        + tokens.content_flow
        + ".\n"
        + "- O motion_language acima define o FEELING do movimento. Respeite.\n"
        + "- Cada section DEVE carregar visual_directive (1-2 frases).\n"
        + "\n# GOOGLE FONTS AUTORIZADO (use SOMENTE estas)\n"
        + f"url: {fonts_url}\n"
        + "- proibido usar Google Font fora dessa lista\n"
        + "\n# RADIUS PROIBIDO para este archetype\n"
        + (", ".join(forbidden_radius) if forbidden_radius else "(nenhum)") + "\n"
        + "\n# COPY ANTI-PREGUICOSA (frases proibidas no copy)\n"
        + ", ".join(lazy_words) + "\n"
        + "\n# DESIGN SYSTEM EMIT (Fase 2 - usado pelo Builder)\n"
        + "- visual_directive por section eh OBRIGATORIO\n"
        + "- paleta deve ser 5-cores (primary/accent/ink/paper/surface)\n"
        + "- typography: cite a font-family EXATA nos h1/headings\n"
        + (
            "\n# POLO BOLD (archetype de impacto — conteudo curto)\n"
            "- O hero.titulo DEVE ter no MAXIMO 3 palavras. Titulo longo quebra "
            "a estetica cinematografica do layout .hero-headline.\n"
            if tokens.archetype in ("industrial-bold", "dark-futurist")
            else ""
        )
        + "\n"
    )

    # Fase 4 - VERDADE OU SILENCIO (ANTI-ALUCINACAO).
    # Quando o lead tem poucos dados (risk > 0.6), proibimos o LLM de
    # inventar fatos. Em vez disso, o site foca em branding + CTA WPP.
    if tokens.max_hallucination_risk > 0.6:
        system_with_briefing += (
            "\n# VERDADE OU SILENCIO (ANTI-ALUCINACAO ABSOLUTA)\n"
            "\nPROIBIDO inventar nomes, CRM/CRP, depoimentos ou precos. "
            "Se o nome do profissional nao vier no lead_data, use termos "
            "institucionais (Nossa Equipe, Nossa Especialista)\n"
            "\nTELEFONE: Se for 41999999999 (placeholder), NAO exibir. "
            "Apenas Fale Conosco ou Agendar via WhatsApp\n"
            "\nEXCECOES: Placeholder Unsplash/SVG sem pessoas brasileiras;\n"
            "termos genericos do setor permitidos se ja no lead_data\n"
            "\nPROIBIDO: nome com sobrenome, CRM numerico, depoimentos\n"
            "com nome/idade, horarios literais, preco R$, modalidades\n"
            "(videochamada/24h). Substituir por Nosso Compromisso.\n"
            "Sempre cidade do lead_data, sem regiao inventada\n"
            # MORTE DOS CLONES (2026-07-18): lead pobre NAO vira mais um
            # apple-minimalist generico. Mantem o archetype sorteado e
            # compensa a falta de texto com ESTETICA DE IMPACTO.
            "\n# MODO DESIGN CINEMATOGRAFICO (lead pobre em dados)\n"
            "Este lead tem POUCOS dados. NAO mude o archetype. NAO encha "
            "com texto generico. MENOS COPY EXIGE MAIS DESIGN. Compense a "
            "falta de texto com AGRESSIVIDADE VISUAL:\n"
            "- Hero com headline de IMPACTO em 15vw (font-size: 15vw / "
            "clamp gigante), poucas palavras, peso 800-900.\n"
            "- Fotos FULL-BLEED (100vw/100vh, Unsplash tematico do segmento) "
            "com overlay escuro e texto sobreposto.\n"
            "- Espacos negativos AGRESSIVOS (py-32/py-48). O vazio e parte "
            "do design.\n"
            "- Mantenha a identidade do archetype (BOLD continua BOLD, "
            "LUXURY continua LUXURY). Nada de cair em minimalismo seguro.\n"
            "- 3-4 sections MAXIMO, cada uma com um unico foco visual forte.\n"
            "- OBRIGATORIO: uma section 'metodologia' com 3 cards de impacto "
            "visuais (Forca, Constancia, Resultado) — titulo + 1 frase cada. "
            "Copy agressiva de posicionamento, ZERO dados inventados. "
            "Isso da massa e peso visual ao site mesmo sem dados do lead.\n"
        )
    else:
        system_with_briefing += (
            "\n# VERDADE OU SILENCIO (leve)\n"
            "Lead tem dados. PROIBIDO inventar nomes, horarios, precos.\n"
        )

    # Fase 5 - ENTITY-PLACEHOLDER INJECTION (padrao Stitch/v0).
    # O LLM escreve TAGS {{business_name}} etc; o Builder resolve fora.
    from backend.services.theme_mapper import (
        ENTITY_TAGS,
        layout_constraints as _layout_constraints,
        LAYOUT_CONSTRAINT_BRIEFINGS,
        value_prop_briefing as _value_prop,
    )
    tags_list = ", ".join(ENTITY_TAGS.keys())
    system_with_briefing += (
        "\n# ENTITY-PLACEHOLDER INJECTION (OBRIGATORIO)\n"
        "NAO escreva nome/telefone/cidade/endereco/email LITERAIS no HTML. "
        "Use SEMPRE estas tags de entidade (o Builder resolve o valor real "
        "fora do LLM):\n"
        f"{tags_list}\n"
        "Exemplos: <h1>{{business_name}}</h1>, "
        "<a href='https://wa.me/{{business_whatsapp}}'>Agendar</a>, "
        "<span>Atendemos em {{business_city}}</span>.\n"
        "Se o dado for nulo, o Builder troca a tag por CTA generico. "
        "Voce so escreve a tag, nunca o valor.\n"
    )

    # Fase 5 - GRACEFUL DEGRADATION (LAYOUT_CONSTRAINT).
    constraints = _layout_constraints(lead)
    if constraints:
        briefs = [
            f"- {c}: {LAYOUT_CONSTRAINT_BRIEFINGS.get(c, '')}"
            for c in constraints
        ]
        system_with_briefing += (
            "\n# LAYOUT_CONSTRAINTS (dados ausentes — NAO preencher com ficcao)\n"
            + "\n".join(briefs)
            + "\n"
        )

    # Fase 5 - VALUE PROP OVER FACT (copy agressiva quando dados escassos).
    if tokens.max_hallucination_risk > 0.6:
        system_with_briefing += (
            "\n# " + _value_prop(lead.get("segmento", "")) + "\n"
        )

    # Fase 3.3 — Design Lessons: paletas/aprovacoes anteriores do segmento
    if _lessons:
        lessons_text = "\n".join(
            f"- archetype={l.archetype} palette={l.palette} score={l.score} feedback={l.feedback}"
            for l in _lessons
        )
        system_with_briefing += (
            "\n# DESIGN LESSONS (aprovacoes anteriores para este segmento)\n"
            "Lead de mesmo segmento aprovou estes designs. "
            "Considere a paleta como referencia, mas adapte ao lead atual:\n"
            + lessons_text
            + "\n"
        )

    response_text, _usage = call_claude(
        system=system_with_briefing,
        user=_build_user_prompt(lead, market_intelligence=market_intelligence),
        max_tokens=16000,
        agent_name="arquiteto",
        lead_id=lead.get("id"),
    )
    data = _extract_json(response_text)
    if not data:
        raise ValueError("Arquiteto retornou JSON vazio ou invalido.")

    required = ["business_name", "hero", "sections", "ctas", "faqs", "paleta"]
    missing = [field for field in required if not data.get(field)]
    if missing:
        raise ValueError(f"DesignerPRD incompleto: {', '.join(missing)}")

    segmento = lead.get("segmento", "")
    sections = [_section_from_dict(s) for s in data.get("sections", [])]
    if not sections:
        raise ValueError("DesignerPRD sem sections materializaveis.")

    # 2. Layout DNA derivado dos tokens (vai pro Builder + tailwind.config).
    layout_dna = {
        "hero_style": tokens.hero_style,
        "layout_family": tokens.layout_family,
        "content_flow": tokens.content_flow,
        "section_count_range": list(tokens.section_count_range),
        "visual_noise": tokens.pattern_svg,
    }

    return DesignerPRD(
        business_name=data.get("business_name", lead.get("nome", "")),
        cidade=lead.get("cidade", ""),
        segmento=segmento,
        hero=data.get("hero", {}),
        sections=sections,
        ctas=data.get("ctas", []),
        faqs=data.get("faqs", []),
        paleta=data.get("paleta", {}),
        seo_keywords=data.get("seo_keywords", []),
        motion_directives=data.get("motion_directives", []),
        design_tokens=tokens_dict,
        layout_dna=layout_dna,
        design_system={
            "archetype": tokens.archetype,
            "archetype_briefing": briefing,
            "google_fonts_url": fonts_url,
            "tailwind_config_inline": _tw_inline(tokens),
            "forbidden_radius_classes": forbidden_radius,
            "forbidden_copy_phrases": lazy_words,
            "hero_style": tokens.hero_style,
            "layout_family": tokens.layout_family,
            "content_flow": tokens.content_flow,
            "motion_language": dict(tokens.motion_language),
            "icons": tokens.icons,
            "pattern_svg": tokens.pattern_svg,
        },
    )
