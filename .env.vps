# Cascade Haiku -> Sonnet -> Opus 4.8
FRALIB_PROXY_LIGHT_MODEL=claude-haiku-4-5
FRALIB_PROXY_DEFAULT_MODEL=claude-sonnet-4-6
FRALIB_PROXY_BUILDER_MODEL=claude-opus-4-8
FRALIB_VITE_NAMEHOST_MODELS=claude-opus-4-8,claude-sonnet-4-6,claude-haiku-4-5
FRALIB_VITE_BUILDER_FALLBACKS=claude-opus-4-8,claude-sonnet-4-6,claude-haiku-4-5
FRALIB_SINGLE_MODEL_ONLY=0

# Builder canonico: OpenUI FraLib Service (Node.js em openui-service/ na porta 3333)
# O builder Python (backend/agents/builder/agent.py) chama via HTTP POST /generate
# O .env do openui-service usa a MESMA ANTHROPIC_API_KEY.
FRALIB_BUILDER_ENGINE=openui
FRALIB_BUILDER_FORCE_ENV_ANTHROPIC=1
FRALIB_STRICT_CANONICAL_PUBLISH=1
FRALIB_OPENUI_PRIMARY_MODEL=claude-opus-4-8
FRALIB_OPENUI_FALLBACK_MODEL=claude-sonnet-4-6
FRALIB_OPENUI_MAX_TOKENS=22000
FRALIB_OPENUI_TEMPERATURE=0.35
# URL do servico Node.js — rota do Docker (host.docker.internal) ou localhost na VPS
OPENUI_SERVICE_URL=http://localhost:7878

