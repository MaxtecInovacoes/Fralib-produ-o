# ===============================================
# FraLib - Environment Configuration Template
# ===============================================
# Este arquivo é PÚBLICO e commitado no git.
# Use para templates/dev. Para produção, copie para .env
# e preencha com os valores reais.

# ===== DATABASE =====
DATABASE_URL=postgresql://usuario:senha@localhost:5432/fralib_db

# ===== JWT & SECURITY =====
# Chave secreta para JWT (mínimo 32 bytes; gere com: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=sua_chave_super_secreta_aqui_minimo_32_bytes
# Chave Fernet para criptografar API keys (gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CSRF_SECRET_KEY=sua_chave_csrf_aqui_minimo_32_bytes
FERNET_KEY=sua_fernet_key_aqui_32_bytes
# Ambiente: dev ou prod
FRALIB_ENV=dev
# Opcional: se vazio, rate limit usa memoria local; se preenchido/REDIS_URL existir, usa backend distribuido.
FRALIB_RATE_LIMIT_STORAGE_URI=

# ===== ADMIN =====
# Email do superadmin (pode ter múltiplos separados por vírgula)
SUPERADMIN_EMAIL=admin@seudominio.com

# ===== LLM PROVIDERS =====
# Anthropic Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api-key-aqui
ANTHROPIC_BASE_URL=https://api.anthropic.com
# OpenAI GPT - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-openai-aqui
# Google AI (Gemini) - https://aistudio.google.com/apikey
GOOGLE_API_KEY=ai-google-key-aqui
# Groq (Llama, Mixtral) - https://console.groq.com/keys
GROQ_API_KEY=gsk-key-aqui
# OpenRouter (multi-provider) - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-key-aqui
# DeepSeek - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-ds-key-aqui
# Qwen (Alibaba) - https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=sk-qwen-key-aqui
# Moonshot Kimi - https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=sk-moong-key-aqui
# KPLabs (kpalabz) - API de video/animacao usada pelos scripts de Copa do Mundo
KPLABS_API_KEY=sk-kpa-key-aqui
KPLABS_API_URL=https://api.kpalabz.com

# Cascade Haiku -> Sonnet -> Opus 4.8
FRALIB_PROXY_LIGHT_MODEL=claude-haiku-4-5
FRALIB_PROXY_DEFAULT_MODEL=claude-sonnet-4-6
FRALIB_PROXY_BUILDER_MODEL=claude-opus-4-8
FRALIB_VITE_NAMEHOST_MODELS=claude-opus-4-8,claude-sonnet-4-6,claude-haiku-4-5
FRALIB_VITE_BUILDER_FALLBACKS=claude-opus-4-8,claude-sonnet-4-6,claude-haiku-4-5
FRALIB_SINGLE_MODEL_ONLY=0

# Builder canonico: Vite/React cinematografico com LLM minimo (copy_only).
FRALIB_BUILDER_ENGINE=vite_react
FRALIB_VITE_LLM_POLICY=copy_only
FRALIB_VITE_CINEMATIC_STUDIO=1
FRALIB_VITE_DISABLE_STUDIO_FALLBACK=1
FRALIB_ALLOW_OPENUI_FALLBACK=0
FRALIB_BUILDER_FORCE_ENV_ANTHROPIC=1
FRALIB_STRICT_CANONICAL_PUBLISH=1
FRALIB_OPENUI_PRIMARY_MODEL=claude-opus-4-8
FRALIB_OPENUI_FALLBACK_MODEL=claude-sonnet-4-6
FRALIB_OPENUI_MAX_TOKENS=22000
FRALIB_OPENUI_TEMPERATURE=0.35

# ===== EXTERNAL SERVICES =====
# Hunter.io - Descoberta de leads - https://hunter.io/api-keys
HUNTER_API_KEY=hunter-key-aqui
# Jina AI - Web scraping - https://jina.ai/reader/
JINA_API_KEY=jina-key-aqui
# Unsplash - Fotos de stock - https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=unsplash-key-aqui
# Pexels - Vídeos de stock - https://www.pexels.com/api/
PEXELS_API_KEY=pexels-key-aqui
# Google Maps - https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=gmaps-key-aqui

# ===== WHATSAPP =====
MEOWHATS_URL=http://localhost:3001
MEOWHATS_KEY=meowhats-key-aqui
WHATSMEOW_DB_URL=postgresql://fralib_user:CHANGE_ME@localhost:5433/fralib_db

# ===== REDIS (Opcional mas recomendado para cache) =====
REDIS_URL=redis://localhost:6379

# ===== BILLING (MERCADO PAGO) =====
# IMPORTANTE: Os tokens reais vão APENAS no .env (não commitado)
# Como gerar: https://www.mercadopago.com.br/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=APP_USR-placeholder-aqui
MERCADOPAGO_WEBHOOK_SECRET=APP_USR-webhook-placeholder
MERCADOPAGO_PLAN_STARTER_AMOUNT=97
MERCADOPAGO_PLAN_PRO_AMOUNT=197
MERCADOPAGO_PLAN_AGENCY_AMOUNT=497
MERCADOPAGO_PLAN_TOKENS_AMOUNT=50
MERCADOPAGO_RECHARGE_MAX_AMOUNT=5000
MERCADOPAGO_PAYMENT_LINK=
# Metodos de pagamento aceitos na assinatura recorrente (separados por virgula)
# Opcoes: pix | credit_card | boleto | debit_card
# Recomendado: "pix,credit_card" para maxima conversao
MERCADOPAGO_PAYMENT_METHODS=pix,credit_card

# ===== SESSION HARDENING =====
FRALIB_COOKIE_SECURE=
FRALIB_CORS_ORIGINS=http://localhost:8000,http://localhost:5173
FRALIB_REQUIRE_2FA=0
FRALIB_REQUIRE_2FA_ROLES=superadmin

# ===== GOOGLE OAUTH (SSO) =====
# Obter em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-client-secret

# ===== APP =====
APP_URL=https://seudominio.com
FRALIB_PUBLIC_URL=https://seudominio.com

# ===== EMAIL =====
# Resend API - https://resend.com/api-keys
RESEND_API_KEY=re_resend-key-aqui
FROM_EMAIL=noreply@seudominio.com

# ===== RATE LIMITING =====
GLOBAL_MAX_CALLS_PER_MIN=60
GLOBAL_DAILY_TOKEN_BUDGET=2000000

# ===== FILE PATHS =====
FRALIB_SITES_ROOT=/var/www/fralib/sites
FRALIB_BUILDER_SANDBOX_ROOT=/tmp/fralib_builder
FRALIB_BUILDER_MANIFEST_DIR=logs/builder_manifests

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=logs/fralib.log

# ===== SDR OUTBOUND QUEUE (SDR 10/10 - ITEM 1) =====
# Ativa rate limit 2 msgs/10min via fila outbound
FRALIB_USE_OUTBOUND_QUEUE=1

# ===== ANALYTICS =====
# Microsoft Clarity - https://clarity.microsoft.com/
CLARITY_API_TOKEN=clarity-token-aqui