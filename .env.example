# FraLib — exemplo seguro de ambiente
# Copie para .env local e preencha valores reais fora do Git.
# Nunca commite chaves reais.

# App
FRALIB_ENV=development
FRALIB_PUBLIC_URL=http://localhost:8001
APP_URL=http://localhost:8001
HOST=0.0.0.0
LOG_LEVEL=INFO
LOG_FILE=

# Segurança
JWT_SECRET_KEY=troque-por-uma-chave-com-mais-de-32-bytes
CSRF_SECRET_KEY=troque-por-outra-chave-com-mais-de-32-bytes
FERNET_KEY=
FRALIB_COOKIE_SECURE=0
FRALIB_CORS_ORIGINS=http://localhost:8001,http://localhost:5173
FRALIB_REQUIRE_2FA=0
FRALIB_REQUIRE_2FA_ROLES=superadmin
SUPERADMIN_EMAIL=

# Banco/cache local
DATABASE_URL=postgresql://fralib_user:fralib_dev_password@localhost:15434/fralib_db
REDIS_URL=redis://localhost:16379

# Produção VPS usa Docker interno:
# DATABASE_URL=postgresql://fralib_user:<senha>@postgres:5432/fralib_db
# REDIS_URL=redis://redis:6379

# LLM / DeployFlow
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://deployflow.com.br/api/public/v1
DEPLOYFLOW_API_KEY=
DEPLOYFLOW_BASE_URL=https://deployflow.com.br/api/public/v1
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# Modelos
FRALIB_PROXY_LIGHT_MODEL=claude-haiku-4-5
FRALIB_PROXY_DEFAULT_MODEL=claude-sonnet-4-6
FRALIB_PROXY_BUILDER_MODEL=claude-sonnet-4-6
FRALIB_SINGLE_MODEL_ONLY=0
MODEL=claude-sonnet-4-6
MAX_TOKENS=64000

# Builder/OpenUI
FRALIB_BUILDER_ENGINE=openui
OPENUI_SERVICE_URL=http://localhost:7878
FRALIB_OPENUI_PRIMARY_MODEL=claude-sonnet-4-6
FRALIB_OPENUI_FALLBACK_MODEL=claude-haiku-4-5
FRALIB_OPENUI_MAX_TOKENS=64000
FRALIB_OPENUI_TEMPERATURE=0.35
FRALIB_VISUAL_DIVERSITY_THRESHOLD=0.86
FRALIB_SITES_ROOT=/var/www/fralib/sites
FRALIB_ARTIFACTS_DIR=/app/artifacts

# Pesquisa e mídia
JINA_API_KEY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# WhatsApp/SDR
MEOWHATS_URL=
MEOWHATS_KEY=
WHATSMEOW_DB_URL=
FRALIB_USE_OUTBOUND_QUEUE=1

# Billing
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PAYMENT_LINK=
MERCADOPAGO_PAYMENT_METHODS=pix,credit_card
MERCADOPAGO_PLAN_STARTER_AMOUNT=97
MERCADOPAGO_PLAN_PRO_AMOUNT=197
MERCADOPAGO_PLAN_AGENCY_AMOUNT=497
MERCADOPAGO_PLAN_TOKENS_AMOUNT=50
MERCADOPAGO_RECHARGE_MAX_AMOUNT=5000

# Email
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com

# Rate limiting / custos
FRALIB_RATE_LIMIT_STORAGE_URI=
GLOBAL_MAX_CALLS_PER_MIN=60
GLOBAL_DAILY_TOKEN_BUDGET=2000000

# Integrações opcionais
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_SECRET=
CLARITY_API_TOKEN=
HUNTER_API_KEY=


# Langfuse - Tracing e Observabilidade
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
