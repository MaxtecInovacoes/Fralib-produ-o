[Unit]
Description=FraLib OpenUI Native - HTML Generation via LLM
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fralib/openui-native
ExecStart=/root/.nvm/versions/node/v20.20.2/bin/node src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=/opt/fralib/openui-native/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openui-native

[Install]
WantedBy=multi-user.target