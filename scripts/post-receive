#!/bin/bash
# post-receive hook — deploy automatico do FraLib
# Instalar: cp scripts/post-receive /root/repos/fralib/hooks/post-receive && chmod +x /root/repos/fralib/hooks/post-receive

set -euo pipefail

FRALIB_DIR="/root/fralib"
WEB_DIR="/var/www/fralib"
LOG_FILE="/root/fralib-logs/deploy.log"

mkdir -p "$(dirname "$LOG_FILE")"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log "=== Deploy iniciado ==="

# Deploy only when master itself changes. Feature branch pushes must never
# republish an older master tree.
DEPLOY_MASTER="false"
while read -r oldrev newrev refname; do
    log "Recebido: $refname $oldrev -> $newrev"
    if [ "$refname" = "refs/heads/master" ]; then
        DEPLOY_MASTER="true"
    fi
done
if [ "$DEPLOY_MASTER" != "true" ]; then
    log "Push sem alteracao em master; deploy ignorado"
    exit 0
fi

# 1. Atualizar working tree do FraLib (unset GIT_DIR porque hooks herdam da bare repo)
log "Atualizando $FRALIB_DIR..."
unset GIT_DIR
cd "$FRALIB_DIR"
ENV_BACKUP=""
if [ -f .env ]; then
    ENV_BACKUP="$(mktemp /tmp/fralib-env.XXXXXX)"
    cp -p .env "$ENV_BACKUP"
    if git ls-files --error-unmatch .env >/dev/null 2>&1; then
        git checkout -- .env 2>&1 | tee -a "$LOG_FILE" || true
    fi
fi
restore_env() {
    if [ -n "$ENV_BACKUP" ] && [ -f "$ENV_BACKUP" ]; then
        cp -p "$ENV_BACKUP" .env
        rm -f "$ENV_BACKUP"
    fi
}
trap restore_env EXIT
git pull --ff-only origin master 2>&1 | tee -a "$LOG_FILE"
restore_env
trap - EXIT

log "Validando frontend canonico..."
"$FRALIB_DIR/venv/bin/python3" "$FRALIB_DIR/scripts/verify_frontend_canonical.py" 2>&1 | tee -a "$LOG_FILE"

# 2. Instalar dependencias Python se requirements mudou
log "Verificando dependencias Python..."
cd "$FRALIB_DIR"
if [ -f backend/requirements.txt ]; then
    "$FRALIB_DIR/venv/bin/pip" install -r backend/requirements.txt --quiet 2>&1 | tail -3 | tee -a "$LOG_FILE"
fi

# 3. Builder OpenUI roda em Python; nao ha dependencias Node do Builder.
log "Builder OpenUI: sem etapa Node"
cd "$FRALIB_DIR"

# 4. Publicar frontend estatico servido pelo Nginx
log "Publicando frontend estatico em $WEB_DIR..."
install -d "$WEB_DIR"
for html in admin.html landing.html login.html planos.html studio.html superadmin.html termos.html privacidade.html; do
    cp -a "$FRALIB_DIR/frontend/$html" "$WEB_DIR/$html"
done
if [ -f "$FRALIB_DIR/frontend/llms.txt" ]; then
    cp -a "$FRALIB_DIR/frontend/llms.txt" "$WEB_DIR/llms.txt"
fi
for dir in blog docs css js static; do
    if [ -d "$FRALIB_DIR/frontend/$dir" ]; then
        cp -a "$FRALIB_DIR/frontend/$dir" "$WEB_DIR"/
    fi
done
if [ -d "$FRALIB_DIR/frontend/images" ]; then
    cp -a "$FRALIB_DIR/frontend/images" "$WEB_DIR"/
fi
for legacy_html in dashboard.html landing-b.html landing-c.html landing-new.html landing-backup-20260511.html landing2.html landing_backup.html; do
    if [ -f "$WEB_DIR/$legacy_html" ]; then
        rm -f "$WEB_DIR/$legacy_html"
    fi
done
log "Frontend publicado"

# 4.1 Publicar Nginx versionado somente apos validar a candidata.
NGINX_SOURCE="$FRALIB_DIR/deploy/nginx/seunegociofralib.conf"
NGINX_TARGET="/etc/nginx/sites-enabled/seunegociofralib.conf"
if [ -f "$NGINX_SOURCE" ]; then
    log "Validando configuracao Nginx canonica..."
    cp -a "$NGINX_TARGET" "$NGINX_TARGET.previous"
    cp -a "$NGINX_SOURCE" "$NGINX_TARGET"
    if nginx -t 2>&1 | tee -a "$LOG_FILE"; then
        rm -f "$NGINX_TARGET.previous"
        systemctl reload nginx
        log "Configuracao Nginx publicada"
    else
        mv -f "$NGINX_TARGET.previous" "$NGINX_TARGET"
        log "Configuracao Nginx rejeitada; configuracao anterior restaurada"
        exit 1
    fi
fi

# 5. Restart do FraLib
log "Restartando fralib..."
if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files 'fralib-*.service' --no-legend 2>/dev/null | grep -q '^fralib-'; then
    for svc in fralib-api fralib-worker fralib-franz fralib-wpp-listener fralib-hermes; do
        if systemctl list-unit-files "${svc}.service" --no-legend 2>/dev/null | grep -q "^${svc}.service"; then
            log "Restart systemd: ${svc}"
            systemctl restart "$svc" 2>&1 | tee -a "$LOG_FILE"
            systemctl is-active "$svc" 2>&1 | tee -a "$LOG_FILE"
        fi
    done
else
    log "systemd fralib nao encontrado; usando PM2 legado"
    pm2 restart fralib --update-env 2>&1 | tee -a "$LOG_FILE"
    pm2 startOrReload ecosystem.config.js --only fralib-worker --update-env 2>&1 | tee -a "$LOG_FILE"
    pm2 delete fralib-bryan-worker 2>/dev/null || true
    pm2 startOrReload ecosystem.config.js --only fralib-franz-worker --update-env 2>&1 | tee -a "$LOG_FILE"
    pm2 startOrReload ecosystem.config.js --only fralib-hermes-watchdog --update-env 2>&1 | tee -a "$LOG_FILE"
fi

log "=== Deploy concluido ==="
