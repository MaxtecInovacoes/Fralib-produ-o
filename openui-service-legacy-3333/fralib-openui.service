[Unit]
Description=FraLib OpenUI Service
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fralib/openui-wandb/backend
Environment=ANTHROPIC_API_KEY=dh-live-5MI2EvgUoAuoLAnP4jn0
Environment=ANTHROPIC_BASE_URL=https://deployflow.com.br/api/public/v1
Environment=OPENAI_COMPATIBLE_ENDPOINT=https://deployflow.com.br/api/public/v1
Environment=OPENAI_COMPATIBLE_API_KEY=dh-live-5MI2EvgUoAuoLAnP4jn0
Environment=PORT=7878
Environment=HOST=0.0.0.0
Environment=OPENUI_LITELLM_CONFIG=/opt/fralib/openui-wandb/backend/litellm-config.yaml
ExecStart=/usr/bin/python3 -m openui --litellm
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
