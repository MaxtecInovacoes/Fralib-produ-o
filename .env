# ===============================================
# FraLib V2 — Environment Configuration
# NÃO versionar .env — usar este como template
# ===============================================

# ---- Ambiente ----
FRALIB_ENV=prod
LOG_LEVEL=INFO
SECRET_KEY=4114d477bfc53269bb171f2578916bc0829841e58268c742037966273445846a

# ---- Banco de Dados (PostgreSQL 16+) ----
DATABASE_URL=postgresql://fralib_user:fralib_dev_password@localhost:15434/fralib_db?sslmode=disable
DATABASE_PASSWORD=fralib_dev_password

# ---- Redis ----
REDIS_URL=redis://localhost:16379/0

# ---- Superadmin ----
SUPERADMIN_EMAIL=admin@seunegociofralib.site

# ---- Domínio ----
FRALIB_SITE_DOMAIN=https://seunegociofralib.site
FRALIB_DOMAIN=https://fralib.com.br
FRALIB_PUBLIC_URL=https://app.seunegociofralib.site

# ============================================================
# LLM PROVIDERS — pelo menos ANTHROPIC_API_KEY é obrigatório
# ============================================================
ANTHROPIC_BASE_URL=https://api.kpalabz.com/v1
GROQ_API_KEY=
OPENROUTER_API_KEY=sk-or-
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
QWEN_API_KEY=

# ============================================================
# HUNTER / GOSOM (Google Maps Scraper)
# ============================================================
GOSOM_ENABLED=1
GOSOM_TIMEOUT=45
GOSOM_POLL_INTERVAL=3
GOSOM_BASE_URL=http://localhost:8085

# ============================================================
# WHATSAPP (MeowWhats)
# ============================================================
WHATSMEOW_API_KEY=
WHATSMEOW_WS_URL=ws://localhost:3001/ws
WHATSMEOW_API_URL=http://localhost:3001

# ============================================================
# BUILDER / FRONTEND
# ============================================================
FRALIB_SITES_ROOT=/app/storage/sites
FRALIB_BUILDER_SANDBOX_ROOT=/tmp/fralib_builder
FRALIB_BUILDER_ENGINE=openui
OPENUI_SERVICE_URL=http://host.docker.internal:7878

# ============================================================
# BUILDER / SITES
# ============================================================
FRALIB_SITES_DIR=/var/www/fralib/sites

# ============================================================
# WORKERS
# ============================================================
WORKER_POLL_SECONDS=3
WORKER_HEARTBEAT_SECS=30
WORKER_REAP_SECS=60
MAX_PIPELINES_GLOBAL=4
FRALIB_UNLIMITED_PIPELINE_TENANTS=2

# ============================================================
# SEGURANÇA
# ============================================================
ALLOWED_ORIGINS=https://seunegociofralib.site
CORS_ORIGINS=https://seunegociofralib.site
GLOBAL_MAX_CALLS_PER_MIN=60
GLOBAL_DAILY_TOKEN_BUDGET=2000000

# ============================================================
# SSL (Let's Encrypt)
# ============================================================
DOMAIN=seunegociofralib.site
LETSENCRYPT_EMAIL=admin@seunegociofralib.site
JWT_SECRET_KEY=4114d477bfc53269bb171f2578916bc0829841e58268c742037966273445846a
MEOWHATS_DB_URL=postgresql://fralib_user:fralib_dev_password@localhost:15434/fralib_db?sslmode=disable
MEOWHATS_PORT=3002

# ===== Proxy LLM único: DeployFlow =====
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-dh-live-ewpGHFGdfh04UI3im6C3
LLM_BASE_URL=https://deployflow.com.br/api/public/v1
LLM_MODEL=claude-sonnet-4-6

# Legado — substituído por LLM_* acima, mantido por compatibilidade reversa
ANTHROPIC_API_KEY=dh-live-ewpGHFGdfh04UI3im6C3
ANTHROPIC_BASE_URL=https://deployflow.com.br/api/public/v1
OPENROUTER_API_KEY=
FRALIB_BUILDER_FAST_PATH=0
FRALIB_PROMPT_AGENT_FLOW=0
MEOWHATS_URL=http://localhost:3001
FRALIB_CORS_ORIGINS=https://seunegociofralib.site

DEPLOYFLOW_API_KEY=dh-live-ewpGHFGdfh04UI3im6C3
